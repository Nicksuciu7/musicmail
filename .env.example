# Explicit local demonstration; fictional data, no email delivery. Set false in production.
MUSICMAIL_DEMO=true
# Supabase project URL and public browser key; leave empty for demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only privileged key for Gmail metadata and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Separate Google OAuth client for Gmail consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only: 32 random bytes encoded as base64; generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Exact application origin for callbacks and same-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local migration tooling only; never NEXT_PUBLIC or needed by the app.
# Copy the database URI from Supabase Connect; keep the real value in .env.local.
SUPABASE_DB_URL=

# Public Turnstile site key; its matching secret belongs in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Google identity login; enable only after configuring Supabase Google Auth.
# Independent of Gmail connection credentials above.
GOOGLE_AUTH_ENABLED=false
